{
  "name": "omni-viewer-chrome",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome Web Store build of Omni Viewer.",
  "scripts": {
    "lint": "node scripts/validate-extension.mjs",
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "release:check": "node scripts/release-check.mjs",
    "package": "npm run release:check && npm run build && node scripts/package.mjs",
    "zip": "node scripts/package.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/jest": "^29.5.14",
    "copy-webpack-plugin": "^12.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "dompurify": "^3.4.9",
    "highlight.js": "^11.11.1",
    "hyparquet-compressors": "^1.1.1",
    "marked": "^16.4.2",
    "mermaid": "^11.15.0",
    "puml-canvas-js": "^0.2.0"
  }
}
